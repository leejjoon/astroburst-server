# Build output
/target/

# Tauri-generated per-platform build artifact (regenerated by `cargo build`/`cargo test`;
# the dormant desktop bin still builds this)
/gen/schemas/linux-schema.json

# Environment
*.local
.env
.env.*

# Sandcastle: session-specific state, never committed
.sandcastle/logs/
.sandcastle/worktrees/
.sandcastle/.env

# Editor/IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Logs
logs/
*.log

# Test artifacts
*.tmp
*.bak

# Large FITS files -- keep small/curated sample data, ignore everything else
*.fits
!exampleFits/sample-data/*.fits
!tests/fixtures/fits_compressed/*.fits
/exampleFits/sample-data/heavyTest/

# Jupyter
.ipynb_checkpoints/

COMMIT_MESSAGE.md
