#!/usr/bin/env bash
#
# Block pushing a `vX.Y.Z` tag whose tagged commit's Cargo.toml version is not
# X.Y.Z. The binary reports CARGO_PKG_VERSION at runtime (startup log, /health,
# and the FITS headers it writes), so a tag/crate mismatch ships a mislabeled
# release. This mirrors the CI guard in .github/workflows/release.yml, but stops
# the bad push before it ever reaches origin.
#
# Activate once per clone:  git config core.hooksPath .githooks
#
# git feeds pre-push one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>

set -euo pipefail

zero="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha _remote_ref _remote_sha; do
  # Only tags shaped like v1.2.3 concern us; skip branches and tag deletions.
  case "$local_ref" in
    refs/tags/v*) ;;
    *) continue ;;
  esac
  [ "$local_sha" = "$zero" ] && continue

  tag_ver="${local_ref#refs/tags/v}"

  # Read Cargo.toml as it exists in the tagged commit (git peels the tag).
  crate_ver="$(git show "${local_sha}:Cargo.toml" 2>/dev/null \
    | grep -m1 '^version = ' \
    | sed -E 's/version = "([^"]+)"/\1/')"

  if [ -z "$crate_ver" ]; then
    echo "pre-push: could not read version from Cargo.toml at tag v${tag_ver}" >&2
    status=1
    continue
  fi

  if [ "$tag_ver" != "$crate_ver" ]; then
    echo "pre-push: BLOCKED — tag v${tag_ver} does not match Cargo.toml version ${crate_ver}" >&2
    echo "         bump Cargo.toml to ${tag_ver} (and re-tag) before pushing." >&2
    status=1
  else
    echo "pre-push: OK — tag v${tag_ver} matches Cargo.toml version ${crate_ver}" >&2
  fi
done

exit "$status"
